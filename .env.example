# Internal browser-development service only. The Windows exe sets its own private endpoint.
WORKBOX_HOST=127.0.0.1
WORKBOX_PORT=4328
WORKBOX_ORIGIN=http://127.0.0.1:4328
# Registration is disabled; no environment override.
# Optional first-run password (8–128 characters); never resets an existing account.
# WORKBOX_INITIAL_PASSWORD=choose-your-own-initial-password
# WORKBOX_DEV_ORIGIN=http://127.0.0.1:5188
# WORKBOX_DATABASE=./runtime/workbox.sqlite
# Desktop runtime data: %LOCALAPPDATA%\XiaoyangWorkbox
