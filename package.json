{
  "name": "xiaoyang-workbox",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build --configLoader runner && tsup server/index.ts --format esm --platform node --out-dir dist-server --external better-sqlite3 --external sharp",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File Start-Workbox.ps1",
    "typecheck": "tsc --noEmit",
    "test:native": "node tests/native-hotkeys.mjs",
    "test:capture-transition": "tsx tests/capture-transition-smoke.ts",
    "test": "tsx --test tests/api.test.ts tests/screenshots.test.ts tests/hotkeys.test.ts tests/rooms.test.ts tests/network.test.ts tests/images.test.ts tests/photos.test.ts tests/computer.test.ts tests/power.test.ts tests/ocr.test.ts tests/app-runtime.test.ts tests/default-account.test.ts",
    "images:host": "node scripts/build-image-host.mjs",
    "preview:test": "tsx tests/browser-server.ts",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "raw:build": "node scripts/build-raw-host.mjs",
    "computer:host": "node scripts/build-computer-host.mjs",
    "test:computer": "node tests/native-computer.mjs",
    "test:video": "node tests/native-video.mjs",
    "test:video-ui": "tsx tests/video-ui.ts",
    "test:video-host": "node tests/video-host.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.4",
    "better-sqlite3": "12.2.0",
    "dotenv": "17.2.0",
    "fastify": "5.12.5",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.35.5",
    "zod": "4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.63.0",
    "tsup": "8.5.0",
    "tsx": "4.20.0",
    "typescript": "5.9.2",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
